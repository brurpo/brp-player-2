#version 450
// bwdif motion-adaptive deinterlacing (port of FFmpeg bwdifdsp.c, float arithmetic).
// With `use_edi`, the spatial estimate comes from NNEDI3 instead of bwdif's own
// interpolation: static areas are woven from neighbouring fields, moving areas get
// the neural estimate.

layout(local_size_x = 16, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D prev_t;
layout(set = 0, binding = 1) uniform sampler2D cur_t;
layout(set = 0, binding = 2) uniform sampler2D next_t;
layout(set = 0, binding = 3, r32f) uniform readonly image2D edi;   // NNEDI3 result
layout(set = 0, binding = 4, r32f) uniform writeonly image2D dst;

layout(push_constant) uniform PC {
    ivec2 size;
    int keep;        // parity of kept lines
    int p2;          // FFmpeg "parity ^ tff": 1 -> prev2 = prev, next2 = cur; 0 -> prev2 = cur, next2 = next
    int use_edi;
    float to_code;   // sample -> code values (0..max)
    float max_code;
} pc;

// Keep line parity when clamping to the plane (FFmpeg mirrors refs at edges).
int row(int r) {
    while (r < 0) r += 2;
    while (r >= pc.size.y) r -= 2;
    return r;
}

// Integer code values, so the arithmetic below matches FFmpeg exactly (shifts floor).
int P(sampler2D t, int x, int y) { return int(round(texelFetch(t, ivec2(x, row(y)), 0).r * pc.to_code)); }

const int LF0 = 4309, LF1 = 213;
const int HF0 = 5570, HF1 = 3801, HF2 = 1016;
const int SP0 = 5077, SP1 = 981;

void main() {
    ivec2 g = ivec2(gl_GlobalInvocationID.xy);
    int x = g.x, y = g.y;
    if (x >= pc.size.x || y >= pc.size.y) return;
    if (((y ^ pc.keep) & 1) == 0) {
        imageStore(dst, g, vec4(texelFetch(cur_t, g, 0).r));
        return;
    }

    int c = P(cur_t, x, y - 1);
    int e = P(cur_t, x, y + 1);
    int pv2 = pc.p2 == 1 ? P(prev_t, x, y) : P(cur_t, x, y);
    int nx2 = pc.p2 == 1 ? P(cur_t, x, y) : P(next_t, x, y);
    int d = (pv2 + nx2) >> 1;
    int td0 = abs(pv2 - nx2);
    int td1 = (abs(P(prev_t, x, y - 1) - c) + abs(P(prev_t, x, y + 1) - e)) >> 1;
    int td2 = (abs(P(next_t, x, y - 1) - c) + abs(P(next_t, x, y + 1) - e)) >> 1;
    int diff = max(max(td0 >> 1, td1), td2);

    int outv;
    if (diff == 0) {
        outv = d;
    } else {
        // Spatial check.
        int pv2m2 = pc.p2 == 1 ? P(prev_t, x, y - 2) : P(cur_t, x, y - 2);
        int nx2m2 = pc.p2 == 1 ? P(cur_t, x, y - 2) : P(next_t, x, y - 2);
        int pv2p2 = pc.p2 == 1 ? P(prev_t, x, y + 2) : P(cur_t, x, y + 2);
        int nx2p2 = pc.p2 == 1 ? P(cur_t, x, y + 2) : P(next_t, x, y + 2);
        int b = ((pv2m2 + nx2m2) >> 1) - c;
        int f = ((pv2p2 + nx2p2) >> 1) - e;
        int dc = d - c, de = d - e;
        int mx = max(max(de, dc), min(b, f));
        int mn = min(min(de, dc), max(b, f));
        diff = max(max(diff, mn), -mx);

        // FFmpeg filter_edge: rows near the top/bottom use a plain average, and skip
        // the spatial check entirely within two rows of the edge.
        bool edge = y < 4 || y + 5 > pc.size.y;
        if (edge && (y < 2 || y + 3 > pc.size.y)) {
            diff = max(max(td0 >> 1, td1), td2);
        }

        int interpol;
        if (edge && pc.use_edi == 0) {
            interpol = (c + e) >> 1;
        } else if (pc.use_edi != 0) {
            interpol = int(round(imageLoad(edi, g).r * pc.to_code));
        } else if (abs(c - e) > td0) {
            int pv2m4 = pc.p2 == 1 ? P(prev_t, x, y - 4) : P(cur_t, x, y - 4);
            int nx2m4 = pc.p2 == 1 ? P(cur_t, x, y - 4) : P(next_t, x, y - 4);
            int pv2p4 = pc.p2 == 1 ? P(prev_t, x, y + 4) : P(cur_t, x, y + 4);
            int nx2p4 = pc.p2 == 1 ? P(cur_t, x, y + 4) : P(next_t, x, y + 4);
            int hf = (HF0 * (pv2 + nx2) - HF1 * (pv2m2 + nx2m2 + pv2p2 + nx2p2) + HF2 * (pv2m4 + nx2m4 + pv2p4 + nx2p4)) >> 2;
            interpol = (hf + LF0 * (c + e) - LF1 * (P(cur_t, x, y - 3) + P(cur_t, x, y + 3))) >> 13;
        } else {
            interpol = (SP0 * (c + e) - SP1 * (P(cur_t, x, y - 3) + P(cur_t, x, y + 3))) >> 13;
        }
        if (interpol > d + diff) interpol = d + diff;
        else if (interpol < d - diff) interpol = d - diff;
        outv = clamp(interpol, 0, int(pc.max_code));
    }
    imageStore(dst, g, vec4(float(outv) / pc.to_code));
}
